# =====================================================================
# Suinami — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored; NEVER commit real keys.
# =====================================================================

# --- Tatum (Sui RPC gateway) -----------------------------------------
# Auth is via the `x-api-key` request HEADER, not the URL. Every Sui
# JSON-RPC call in the app routes through this gateway (no public fullnode).
TATUM_API_KEY=
SUI_NETWORK=testnet                       # mainnet | testnet | devnet
SUI_RPC_URL=https://sui-testnet.gateway.tatum.io
# mainnet: https://sui-mainnet.gateway.tatum.io
# devnet:  https://sui-devnet.gateway.tatum.io

# --- Walrus ----------------------------------------------------------
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_DEFAULT_EPOCHS=5                    # storage duration in epochs

# --- Sui Move package (filled after `pnpm --filter @suinami/contracts run publish`) ---
SUINAMI_PACKAGE_ID=
SUINAMI_FEED_OBJECT_ID=                    # shared Feed registry object

# Funded testnet deployer key (bech32 suiprivkey…) used to publish the Move
# package. `pnpm setup:deployer` generates + faucet-funds one into .env.
SUINAMI_DEPLOYER_KEY=
# Funded MAINNET deployer key — used when SUI_NETWORK=mainnet (publish/seed/
# set-avatar auto-select it). `pnpm setup:mainnet` generates one (then fund it
# with real SUI + WAL). Controls real funds — NEVER commit the real value.
SUINAMI_MAINNET_DEPLOYER_KEY=

# --- Content pipeline (OPTIONAL — only for `pnpm ads` / generated promos) ---
# Billable third-party keys; not needed to run the app or the on-chain flow.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
EL_VOICE_EN_F=                            # ElevenLabs voice IDs (EN/JP, F/M)
EL_VOICE_EN_M=
EL_VOICE_JP_F=
EL_VOICE_JP_M=

# --- API server ------------------------------------------------------
API_PORT=8787
DATABASE_URL=./suinami.db                  # sqlite file (relative to apps/api)

# --- Client (Vite) ---------------------------------------------------
# Vite only exposes vars prefixed with VITE_ to the browser. The browser's
# SuiClient talks to Tatum directly, so the (testnet) key is exposed client-side
# by design — acceptable for a hackathon; a production build would proxy reads.
VITE_SUI_NETWORK=testnet
VITE_SUI_RPC_URL=https://sui-testnet.gateway.tatum.io
VITE_TATUM_API_KEY=
VITE_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
VITE_SUINAMI_PACKAGE_ID=
VITE_SUINAMI_FEED_OBJECT_ID=
VITE_API_BASE_URL=http://localhost:8787
